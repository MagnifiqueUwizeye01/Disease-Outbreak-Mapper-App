<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Map Container -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white" />

    <!-- Map Overlay Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:layout_margin="16dp"
        android:background="@drawable/map_controls_bg"
        android:elevation="8dp">

        <!-- HIGH RISK CHIP -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_high_risk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High Risk"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/error"
            app:chipIcon="@drawable/ic_high_risk_small"
            app:chipIconTint="@color/white"
            app:checkedIconVisible="true"
            android:checkable="true"
            android:layout_margin="8dp" />

        <!-- MEDIUM RISK CHIP -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_medium_risk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medium Risk"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/medical_teal_primary"
            app:chipIcon="@drawable/ic_medium_risk"
            app:chipIconTint="@color/white"
            app:checkedIconVisible="true"
            android:checkable="true"
            android:layout_margin="8dp" />

        <!-- LOW RISK CHIP -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_low_risk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low Risk"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/medical_green_primary"
            app:chipIcon="@drawable/ic_low_risk"
            app:chipIconTint="@color/white"
            app:checkedIconVisible="true"
            android:checkable="true"
            android:layout_margin="8dp" />

    </LinearLayout>

    <!-- Bottom Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/medical_green_light"
        app:strokeWidth="1dp"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outbreak Overview"
                android:textColor="@color/medical_green_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Active Cases -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24"
                        android:textColor="@color/medical_green_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- High Risk Zones -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="@color/error"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High Risk"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Affected Areas -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8"
                        android:textColor="@color/medical_teal_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zones"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Refresh FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_refresh_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        app:backgroundTint="@color/medical_teal_primary"
        app:srcCompat="@drawable/ic_refresh"
        app:tint="@color/white"
        android:contentDescription="Refresh map" />

    <!-- Location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="88dp"
        android:layout_marginEnd="24dp"
        app:backgroundTint="@color/medical_green_primary"
        app:srcCompat="@drawable/ic_my_location"
        app:tint="@color/white"
        android:contentDescription="My location" />

</FrameLayout>
