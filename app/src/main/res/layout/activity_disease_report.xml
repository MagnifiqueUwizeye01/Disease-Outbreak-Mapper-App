<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report Disease Case"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Disease Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Disease *"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerDisease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Other Disease Input (Initially Hidden) -->
        <LinearLayout
            android:id="@+id/layoutOtherDisease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Specify Disease Name *"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etOtherDisease"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter disease name"
                android:inputType="textCapWords" />
        </LinearLayout>

        <!-- Patient Full Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patient Full Name *"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPatientFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter patient's full name"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp" />

        <!-- Patient Age -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patient Age *"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPatientAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter patient age"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- Location Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location *"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location: Not captured"
            android:textStyle="italic"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:background="@android:color/darker_gray" />

        <Button
            android:id="@+id/btnCaptureLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture GPS Location"
            android:layout_marginBottom="16dp" />

        <!-- Symptoms -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Symptoms"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSymptoms"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Describe symptoms (optional)"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="24dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Report"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp" />

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Dashboard"
            android:backgroundTint="#9E9E9E" />

    </LinearLayout>

</ScrollView>