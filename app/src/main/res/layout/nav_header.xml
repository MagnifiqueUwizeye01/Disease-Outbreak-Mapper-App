<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="bottom"
    android:background="@drawable/bg_app_bar_gradient">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_healthcare"
        android:tint="@color/medical_gold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/nav_header_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Community Health Worker"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/nav_header_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Facility / Region"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:alpha="0.9"
        android:layout_marginTop="4dp" />

</LinearLayout>
