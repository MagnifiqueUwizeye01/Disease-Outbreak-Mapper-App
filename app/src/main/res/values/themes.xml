<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material Design 3 - Medical Theme -->
    <style name="Base.Theme.HealthTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors (Medical Blue) -->
        <item name="colorPrimary">@color/medical_blue_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/medical_blue_light</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        
        <!-- Secondary colors (Teal/Green) -->
        <item name="colorSecondary">@color/medical_teal_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/medical_teal_light</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Tertiary colors (Gold/Amber for accents) -->
        <item name="colorTertiary">@color/medical_gold</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="colorTertiaryContainer">@color/medical_gold_light</item>
        <item name="colorOnTertiaryContainer">@color/black</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/background_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        
        <!-- Background -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/text_primary</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/medical_blue_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <style name="Theme.HealthTrack" parent="Base.Theme.HealthTrack" />
    
    <!-- Splash Screen Theme -->
    <style name="Theme.HealthTrack.Splash" parent="Theme.HealthTrack">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>