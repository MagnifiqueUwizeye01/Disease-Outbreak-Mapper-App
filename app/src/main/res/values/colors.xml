<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Colors -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Medical Blue Palette (updated to requested theme) -->
    <!-- Primary blue for toolbar, primary buttons, active states -->
    <color name="medical_blue_primary">#0A73FF</color>
    <!-- Darker blue for status bar / stronger emphasis -->
    <color name="medical_blue_dark">#0A1A3F</color>
    <!-- Light blue for subtle backgrounds / chips -->
    <color name="medical_blue_light">#E2EEFF</color>

    <!-- Medical Teal/Green Palette (used more sparingly now) -->
    <color name="medical_teal_primary">#00C851</color>
    <color name="medical_teal_dark">#00A040</color>
    <color name="medical_teal_light">#C6F7DA</color>

    <!-- Orange Accents / Highlights -->
    <!-- Primary accent / highlight (selected states, FAB) -->
    <color name="medical_gold">#FF7A00</color>
    <!-- Slightly lighter orange for hover / pressed / secondary -->
    <color name="medical_amber">#FF9933</color>
    <!-- Very light orange for subtle backgrounds / dividers -->
    <color name="medical_gold_light">#FFF2E6</color>

    <!-- Backgrounds & Surfaces -->
    <!-- Main app background -->
    <color name="background_light">#FFFFFF</color>
    <color name="background_white">#FFFFFF</color>
    <!-- Card surface background -->
    <color name="surface_card">#FFFFFF</color>

    <!-- Dark theme counterparts -->
    <color name="background_dark">#101820</color>
    <color name="surface_dark">#161F29</color>

    <!-- Text Colors -->
    <!-- Primary titles and labels -->
    <color name="text_primary">#0A1A3F</color>
    <!-- Secondary descriptions / helper text -->
    <color name="text_secondary">#6E7A8A</color>
    <!-- Disabled / hint text -->
    <color name="text_hint">#C4CCD6</color>
    <color name="text_on_primary">#FFFFFF</color>

    <!-- Dark text colors -->
    <color name="text_primary_dark">#ECEFF1</color>
    <color name="text_secondary_dark">#B0BEC5</color>

    <!-- Status Colors -->
    <color name="success">#00C851</color>
    <color name="warning">#FF7A00</color>
    <color name="error">#D62828</color>
    <color name="info">#0A73FF</color>

    <!-- Legacy/Mapped Colors -->
    <color name="medical_dark_teal">@color/medical_blue_primary</color>
    <color name="medical_medium_teal">@color/medical_blue_light</color>
    <color name="medical_vibrant_teal">@color/medical_teal_primary</color>
    <color name="medical_light_teal">@color/medical_teal_light</color>
    <color name="medical_cream">@color/background_light</color>

    <color name="primary">@color/medical_blue_primary</color>
    <color name="primary_dark">@color/medical_blue_dark</color>
    <color name="primary_light">@color/medical_blue_light</color>

    <color name="secondary">@color/medical_teal_primary</color>
    <color name="secondary_dark">@color/medical_teal_dark</color>
    <color name="secondary_light">@color/medical_teal_light</color>

    <color name="accent">@color/medical_gold</color>
    <color name="accent_dark">@color/medical_amber</color>

    <color name="background">@color/background_light</color>
    <color name="surface">@color/surface_card</color>

    <color name="text_medical">@color/medical_blue_primary</color>

    <!-- Dividers -->
    <color name="divider">#B0BEC5</color>

    <!-- Gradient Colors -->
    <color name="gradient_start">@color/medical_blue_dark</color>
    <color name="gradient_mid">@color/medical_blue_primary</color>
    <color name="gradient_end">@color/medical_teal_primary</color>
</resources>
