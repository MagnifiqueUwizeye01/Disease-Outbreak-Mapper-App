    <!-- Primary gold for accents, highlights, secondary actions -->
    <color name="medical_gold_primary">#FFA000</color>
    <!-- Darker gold for pressed states -->
    <color name="medical_gold_dark">#FF8F00</color>
    <!-- Light gold for subtle backgrounds -->
    <color name="medical_gold_light">#FFF8E1</color>

