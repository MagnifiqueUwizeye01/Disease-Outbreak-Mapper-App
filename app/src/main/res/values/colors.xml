<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Colors -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Medical Green Palette -->
    <!-- Primary green for toolbar, primary buttons, active states -->
    <color name="medical_green_primary">#2E7D32</color>
    <!-- Darker green for status bar / stronger emphasis -->
    <color name="medical_green_dark">#1B5E20</color>
    <!-- Light green for subtle backgrounds / chips -->
    <color name="medical_green_light">#E8F5E9</color>

    <!-- Medical Teal Palette -->
    <!-- Primary teal for medium risk, secondary actions -->
    <color name="medical_teal_primary">#00C851</color>
    <!-- Darker teal for pressed states -->
    <color name="medical_teal_dark">#00A040</color>
